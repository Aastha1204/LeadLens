# All optional. The demo runs fully offline without any of these.

# Public URL used for Open Graph tags (set on Vercel to your deployment URL)
NEXT_PUBLIC_SITE_URL=https://leadlens.example.com

# Optional LLM commentary (any OpenAI-compatible chat-completions endpoint).
# Only metrics_json display strings are sent: no lead rows, names or phone numbers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional "Send to my phone" via the WhatsApp Cloud API test number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
